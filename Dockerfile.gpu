# Base -cudnn-runtime : CTranslate2 (faster-whisper ET CrisperWhisper) exige
# cuDNN 9. Sur la base -runtime simple, ça ne fonctionnait que grâce au cuDNN
# embarqué par la roue torch et préchargé par l'« import torch » de config.py
# — dépendance accidentelle qu'on ne veut pas garder avec deux consommateurs.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV RUNNING_IN_DOCKER=1
ENV DEBIAN_FRONTEND=noninteractive
# Sans cela, les logs applicatifs (print) restent dans le tampon stdout et
# n'apparaissent jamais dans « docker logs ».
ENV PYTHONUNBUFFERED=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3-pip \
    ffmpeg git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3

WORKDIR /app

# Python dependencies
COPY requirements-gpu.txt .
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir -r requirements-gpu.txt && \
    # faster-whisper dépend de CTranslate2 amont, CrisperWhisper de son fork
    # (APIs prefill / forward_step / set_alignment_heads /
    # generate_greedy_with_attention). Les deux distributions fournissent le
    # MÊME module « ctranslate2 » : la dernière installée écrase l'autre, et
    # l'ordre choisi par pip n'est pas garanti. On réinstalle donc le fork en
    # dernier, proprement — il est un surensemble de l'amont, faster-whisper
    # continue de fonctionner avec.
    python3 -m pip uninstall -y ctranslate2 ctranslate2-crisperwhisper && \
    python3 -m pip install --no-cache-dir ctranslate2-crisperwhisper && \
    # Échoue le build si l'amont a repris la place (plutôt que de le
    # découvrir au premier préchargement en production).
    python3 -c "import importlib.metadata as m; d=m.packages_distributions().get('ctranslate2', []); assert 'ctranslate2-crisperwhisper' in d, 'CTranslate2 fourni par %s, fork CrisperWhisper attendu' % d; print('[build] module ctranslate2 fourni par', d)"

# Application code
COPY . .
RUN mkdir -p recordings

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
